{
  "name": "ignia-threejs",
  "version": "0.5.0",
  "private": false,
  "description": "IGNIA reactive volume lab with corrected MAC transport, GPU ember tracers, FLOAT EXR passes and native OpenVDB export.",
  "scripts": {
    "start": "python tools/serve.py",
    "build": "node tools/build_standalone.cjs",
    "export-shaders": "node tools/export-shaders.cjs",
    "export-detail": "node tools/export-detail.cjs",
    "export-diagnostics": "node tools/export-diagnostics.cjs",
    "check": "node --check src/engine.js && node --check src/studio.js && node --check src/detail.js && node --check src/detail-shaders.js && node --check src/presets.js && node --check src/controls.js && node --check src/embers.js && node --check src/exr.js",
    "test:numerics": "python tools/test_lab.py",
    "test:browser": "python tools/browser_delivery.py",
    "test:state": "python tools/test_browser_state.py",
    "test:optics": "python tools/test_optical_segment.py",
    "test:embers": "python tools/test_embers.py",
    "test:exr": "node tools/test_exr.cjs",
    "test:vdb": "python tools/test_vdb.py",
    "export:vdb": "python tools/export_vdb.py",
    "capture:catalogue": "python tools/capture_delivery.py --mode catalogue",
    "capture:verification": "python tools/capture_delivery.py --mode verification",
    "assemble": "python tools/build_reels.py"
  },
  "license": "GPL-2.0-only",
  "dependencies": {
    "three": "0.180.0"
  }
}
